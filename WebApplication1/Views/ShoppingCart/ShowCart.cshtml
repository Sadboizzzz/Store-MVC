@model WebApplication1.Models.Cart
@using System.Linq
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<h2 class="cart-page-title">Giỏ hàng của bạn</h2>

@if (TempData["CartError"] != null)
{
    <div class="cart-message-error">@TempData["CartError"]</div>
}

@if (!Model.Items.Any())
{
    <div class="catalog-empty">Giỏ hàng đang trống.</div>
}
else
{
    <div class="cart-table-wrap">
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="cart-product">
                                <img src="~/Content/images/@item.ImageUrl" alt="@item.ProductName" />
                                <div class="cart-product-info">
                                    <strong>@item.ProductName</strong>
                                    <small>Tồn kho: @item.StockQuantity</small>
                                </div>
                            </div>
                        </td>
                        <td>@item.UnitPrice.ToString("#,##0") đ</td>
                        <td>
                            @using (Html.BeginForm("UpdateQuantity", "ShoppingCart", FormMethod.Post, new { @class = "cart-update-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductID" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockQuantity" />
                                <button type="submit" class="btn-soft">Cập nhật</button>
                            }
                        </td>
                        <td class="product-price">@item.LineTotal.ToString("#,##0") đ</td>
                        <td>
                            @using (Html.BeginForm("Remove", "ShoppingCart", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.ProductID" />
                                <button type="submit" class="btn-soft">Xóa</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="cart-summary">
        <div class="cart-summary-details">
            <div>Tổng số lượng: <strong>@Model.TotalQuantity()</strong></div>
            <div>Tổng tiền: <strong>@Model.TotalMoney().ToString("#,##0") đ</strong></div>
        </div>
        <div>
            @Html.ActionLink("Tiếp tục mua hàng", "Index", "Store", null, new { @class = "btn-soft" })
            @Html.ActionLink("Tiến hành đặt hàng", "Checkout", "ShoppingCart", null, new { @class = "btn-brand" })
        </div>
    </div>
}
